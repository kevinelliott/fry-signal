{
  "name": "fry-signal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "next@16.2.11>postcss": "8.5.25",
      "next@16.2.11>sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @fry-signal/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @fry-signal/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @fry-signal/domain build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @fry-signal/domain test",
    "test:e2e": "pnpm --filter @fry-signal/web test:e2e",
    "test:e2e:production": "pnpm build && FRY_SIGNAL_E2E_PRODUCTION=1 pnpm --filter @fry-signal/web test:e2e",
    "test:gate1": "node --test scripts/gate1/validate-cohort.test.mjs",
    "gate1:validate": "node scripts/gate1/validate-cohort.mjs",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:gate1 && pnpm --filter @fry-signal/web test:dependency-compat && pnpm build && FRY_SIGNAL_E2E_PRODUCTION=1 pnpm --filter @fry-signal/web test:e2e",
    "tezos:localnet": "node ../project-crypt-tezos-localnet/scripts/profile.mjs localnet",
    "tezos:shadownet": "node ../project-crypt-tezos-localnet/scripts/profile.mjs shadownet"
  }
}
